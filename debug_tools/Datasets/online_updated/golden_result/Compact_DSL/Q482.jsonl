["right","Region",{"variant":"title-content"},["right_title","right_support"]]
["right_title","SingleLineTitle",{"title":"未来天气","fontSize":12}]
["right_support","SecondaryBody",{"items":[{"label":"湿度 ","value":"{{ ${/data/weather/current/humidityPercent} + '%' }}"},{"label":"风向 ","value":{"path":"/data/weather/current/windDirection"}},{"label":"风力 ","value":"{{ ${/data/weather/current/windLevel} + '级' }}"},{"label":"地区 ","value":{"path":"/data/weather/location/districtName"}},{"label":"明天 ","value":"{{ ${/data/weather/daily/1/condition} + ' ' + ${/data/weather/daily/1/temperatureRangeText} }}"}],"fontSize":12}]
